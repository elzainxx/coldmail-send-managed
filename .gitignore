# ── Secrets & key material — NEVER committed ────────────────────────────────
# Private keys use the .key extension (ca.key, control.key, worker-<id>.key, sink.key)
# and the harness generates ephemeral certs OUTSIDE secrets/, so cover every location.
*.key
*.pem
secrets/*
!secrets/.gitkeep
**/certs/*.key
**/certs/*.crt
tests/harness/certs/
deploy/certs/
.env
.env.*
!.env.example
!.env.ci

# ── Go (Control) ──────────────────────────────────────────────────────────────
/services/control/bin/
/tools/send-managed-migrate/bin/
/tools/provision-worker/bin/
**/bin/send-managed-migrate
**/bin/provision-worker
# A bare `go build ./...` inside a main package's own directory drops the binary THERE, not under
# bin/ — so the patterns above do not catch it and `git add -A` will happily stage a 15MB artifact
# (caught during fix-plan item 12 by the artifact turning up in `git status`). Named explicitly
# rather than as a blanket rule, so a real file that happens to share a tool's name is not hidden.
/tools/send-managed-migrate/send-managed-migrate
/tools/provision-worker/provision-worker
*.exe
*.out
*.test

# ── Node (worker) ──────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
*.tsbuildinfo
/services/worker/dist/

# ── misc ────────────────────────────────────────────────────────────────────
.DS_Store
*.log
/tmp/
coverage/

# Scratch output from tests/manual/launch-campaign.sh — the job_item/job id lists it writes so a
# follow-up assertion can name the exact rows it expects. Per-run and disposable; the SCRIPT is
# tracked, its output is not.
*.ids
*.items

# Reference codebase (has its own nested .git; inspiration only, not part of this repo)
Docs/history/mailflow-worker (Sender Inspiration)/
